{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OffClass",
  "version": "0.1.0",
  "identifier": "com.offclass.player",
  "build": {
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OffClass - Offline Course Player",
        "width": 1366,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "OffClass",
    "copyright": "Copyright © 2026 OffClass",
    "category": "Education",
    "shortDescription": "Offline Course Player",
    "longDescription": "OffClass is a modern offline video course player designed for distraction-free learning.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  }
}
